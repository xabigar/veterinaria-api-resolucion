# NO ES NECESARIO: sin .env, MongoDB arranca en memoria.
# Para usar una base de datos real: copia este fichero como .env
# y elige una URI.

# MongoDB local
# MONGODB_URI=mongodb://127.0.0.1:27017/veterinaria

# MongoDB Atlas (usuario, contraseña y clúster son los tuyos)
# MONGODB_URI=mongodb+srv://usuario:contraseña@cluster0.xxxxx.mongodb.net/veterinaria

# PORT=3000
